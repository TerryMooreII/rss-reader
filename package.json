    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "dompurify": "^3.4.16",
    "pinia": "^4.0.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
